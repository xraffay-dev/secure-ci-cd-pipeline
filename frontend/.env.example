# Frontend runtime/build-time API base URL override for browser requests.
# Keep empty to use Vite dev proxy + relative /api.
# Example: https://api.mycompany.com
VITE_API_BASE_URL=

# Vite dev server proxy target for local development (used by npm run dev only).
# Example: http://localhost:8000
VITE_API_PROXY_TARGET=http://localhost:8000

# Backward-compatible alias for proxy target.
# TARGET_URL=http://localhost:8000
